{
  "functions": [
    {
      "codebase": "default",
      "ignore": [
        "venv",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "images",
        "pdfs",
        "tempImages",
        "masks",
        "__pycache__"
      ],
      "source": "functions",
      "runtime": "python311"
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
